{
  "name": "osticky",
  "type": "module",
  "version": "0.2.0",
  "description": "Electron app with React frontend and Node.js backend",
  "main": "dist/main/main.js",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run frontend:dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "frontend:dev": "cd frontend && npm run dev",
    "rebuild": "electron-rebuild",
    "make": "electron-forge make",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "dayjs": "^1.11.19",
    "sqlite3": "^5.1.6"
  },
  "build": {
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "appId": "com.osticky.app",
    "productName": "OSticky",
    "files": [
      "!*.traineddata",
      "dist/**/*",
      "frontend/dist/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!*.sh",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [],
    "directories": {
      "output": "out"
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "./electron/resources/assets/logo-256.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "./dist-electron/resources/assets/icon.icns",
      "category": "public.app-category.utilities",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OSticky",
      "installerIcon": "./electron/resources/assets/logo-256.ico",
      "uninstallerIcon": "./electron/resources/assets/logo-256.ico",
      "installerHeaderIcon": "./electron/resources/assets/logo-256.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "dmg": {
      "iconSize": 100,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 150,
          "y": 200
        },
        {
          "x": 450,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "format": "ULFO"
    }
  },
  "author": {
    "name": "蔡包",
    "email": "your.email@example.com"
  }
}
